{
  "manifest_version": 3,
  "name": "DigiOffice Mutatie Diff",
  "version": "1.1.0",
  "description": "Vergelijk mutaties in DigiOffice.",
  "permissions": [
    "scripting",
    "tabs"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "DigiOffice Mutatie Diff",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "Icons/icon16.png",
    "48": "Icons/icon48.png",
    "128": "Icons/icon128.png"
  }
}
